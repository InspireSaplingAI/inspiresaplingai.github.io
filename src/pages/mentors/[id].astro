---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import { createClient } from '../../lib/supabase-server'

export const prerender = false

const supabase = createClient(Astro)
const { data: { user } } = await supabase.auth.getUser()
const mentorId = Astro.params.id

// Fetch the mentor by id (must be approved)
const { data: mentor, error } = await supabase
    .from('mentor_profiles')
    .select('*')
    .eq('id', mentorId)
    .eq('approved', true)
    .maybeSingle()

if (error) {
    console.error('[mentors/[id].astro] Failed to fetch mentor:', error.message)
}

if (!mentor) {
    return Astro.redirect('/mentors')
}

function formatRate(cents: number | null): string {
    if (!cents) return 'Rate TBD'
    return `$${(cents / 100).toFixed(0)}`
}
---

<Layout title={`${mentor.name} — Mentor | InspireSaplingAI`}>
    <Navbar user={user} />
    <div class="min-h-screen bg-gray-50 pt-24 pb-12">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Back link -->
            <a href="/mentors" class="inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-6">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                All Mentors
            </a>

            <!-- Mentor Hero Card -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 mb-8">
                <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
                    {mentor.avatar_url ? (
                        <img
                            src={mentor.avatar_url}
                            alt={mentor.name}
                            class="w-24 h-24 rounded-full object-cover flex-shrink-0"
                        />
                    ) : (
                        <div class="w-24 h-24 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 text-3xl font-bold flex-shrink-0">
                            {mentor.name.charAt(0).toUpperCase()}
                        </div>
                    )}
                    <div class="flex-1 min-w-0">
                        <h1 class="text-2xl font-bold text-gray-900 mb-1">{mentor.name}</h1>
                        <p class="text-gray-500">
                            {[mentor.title, mentor.company].filter(Boolean).join(' · ')}
                        </p>
                        {mentor.expertise && mentor.expertise.length > 0 && (
                            <div class="flex flex-wrap gap-1.5 mt-3">
                                {mentor.expertise.map((tag) => (
                                    <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-primary-50 text-primary-700">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )}
                    </div>
                    <div class="text-right flex-shrink-0">
                        <p class="text-3xl font-bold text-gray-900">{formatRate(mentor.hourly_rate)}<span class="text-base font-medium text-gray-400">/hr</span></p>
                        <p class="text-xs text-gray-400 mt-1">per session</p>
                    </div>
                </div>
            </div>

            <!-- Pricing transparency disclosure -->
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 mb-8 text-center">
                <p class="text-sm text-amber-800">
                    💡 <strong>Sessions are fee-based.</strong> Proceeds support mentor stipends and InspireSaplingAI operations.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Full bio -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">About {mentor.name}</h2>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                        {mentor.bio ? (
                            <p class="text-gray-600 leading-relaxed whitespace-pre-line">{mentor.bio}</p>
                        ) : (
                            <p class="text-gray-400">{mentor.name} is an experienced mentor with InspireSaplingAI.</p>
                        )}
                    </div>

                    {mentor.hourly_rate && (
                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mt-6">
                            <h3 class="font-semibold text-gray-900 mb-3">Session Details</h3>
                            <ul class="space-y-2 text-sm text-gray-600">
                                <li class="flex justify-between">
                                    <span>Duration</span>
                                    <span class="font-medium text-gray-900">60 minutes</span>
                                </li>
                                <li class="flex justify-between">
                                    <span>Rate</span>
                                    <span class="font-medium text-gray-900">{formatRate(mentor.hourly_rate)}/hour</span>
                                </li>
                                <li class="flex justify-between">
                                    <span>Format</span>
                                    <span class="font-medium text-gray-900">Video call</span>
                                </li>
                            </ul>
                        </div>
                    )}
                </div>

                <!-- Booking column -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">Book a Session</h2>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
                        <ol class="space-y-4 text-sm text-gray-600">
                            <li class="flex gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-600 text-white text-xs font-bold flex items-center justify-center">1</span>
                                <span>Pick a time on the calendar below</span>
                            </li>
                            {mentor.stripe_price_id ? (
                                <li class="flex gap-3">
                                    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-primary-600 text-white text-xs font-bold flex items-center justify-center">2</span>
                                    <span>
                                        Complete payment via Stripe ({formatRate(mentor.hourly_rate)}/session)
                                        <button
                                            type="button"
                                            id="checkout-btn"
                                            data-mentor-id={mentor.id}
                                            class="block mt-2 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                                        >
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h2m4 0h4M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                            </svg>
                                            Book & Pay
                                        </button>
                                    </span>
                                </li>
                            ) : (
                                <li class="flex gap-3">
                                    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gray-300 text-white text-xs font-bold flex items-center justify-center">2</span>
                                    <span class="text-gray-400">Payment not yet configured for this mentor — please check back soon.</span>
                                </li>
                            )}
                        </ol>
                    </div>

                    <!-- Cal.com embed -->
                    {mentor.cal_link ? (
                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                            <iframe
                                src={mentor.cal_link}
                                title={`Book a session with ${mentor.name}`}
                                class="w-full"
                                style="height: 700px; border: none;"
                                loading="lazy"
                            ></iframe>
                        </div>
                    ) : (
                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-10 text-center">
                            <p class="text-4xl mb-3">📅</p>
                            <p class="text-gray-600 font-medium">Booking calendar coming soon</p>
                            <p class="text-sm text-gray-400 mt-1">This mentor's availability is being set up.</p>
                        </div>
                    )}
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    const checkoutBtn = document.getElementById('checkout-btn')
    checkoutBtn?.addEventListener('click', async () => {
        const mentorId = checkoutBtn.dataset.mentorId
        if (!mentorId) return

        checkoutBtn.disabled = true
        checkoutBtn.textContent = 'Redirecting to payment…'

        try {
            const res = await fetch('/api/coaching/create-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mentor_id: mentorId }),
            })

            if (res.status === 401) {
                window.location.href = `/auth/login?next=${encodeURIComponent(window.location.pathname)}`
                return
            }

            const data = await res.json().catch(() => ({}))
            if (!res.ok) {
                throw new Error(data.error || 'Checkout failed. Please try again.')
            }

            if (data.url) {
                window.location.href = data.url
            }
        } catch (err) {
            alert(err instanceof Error ? err.message : 'Network error. Please try again.')
            checkoutBtn.disabled = false
            checkoutBtn.textContent = 'Book & Pay'
        }
    })
</script>