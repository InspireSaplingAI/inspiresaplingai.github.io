---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const user = Astro.locals.user;
---

<Layout
  title="Community Forum | InspireSaplingAI"
  description="Join the InspireSaplingAI community forum to discuss AI learning, career growth, and collaborate on projects. Powered by GitHub Discussions."
>
  <Navbar user={user} />
  <!-- Hero -->
  <section class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-emerald-900 pt-32 pb-20 px-4 text-white text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-5 leading-tight">
        Community Forum
      </h1>
      <p class="text-xl text-indigo-100 max-w-2xl mx-auto leading-relaxed">
        A space to learn together, share resources, discuss AI, and support each other's career journeys.
      </p>
      <a
        href="https://github.com/InspireSaplingAI/inspiresaplingai.github.io/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-8 px-6 py-3 bg-white/10 border border-white/30 text-white font-semibold rounded-xl hover:bg-white/20 transition-colors"
      >
        View on GitHub Discussions
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-16">
    <!-- giscus forum embed -->
    <div class="giscus">
      <script src="https://giscus.app/client.js"
              data-repo="InspireSaplingAI/inspiresaplingai.github.io"
              data-repo-id="R_kgDOOUhVeg"
              data-category="General"
              data-category-id="DIC_kwDOOUhVes4DBMwk"
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="en"
              crossorigin="anonymous"
              async>
      </script>
    </div>
  </div>
</Layout>
