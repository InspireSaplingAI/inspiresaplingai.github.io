---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EventCard from '../components/events/EventCard.astro';

const user = Astro.locals.user;
const allEvents = await getCollection('events');

const upcomingEvents = allEvents
  .filter(e => e.data.status === 'upcoming')
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

const pastEvents = allEvents
  .filter(e => e.data.status === 'past')
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout
  title="Events | InspireSaplingAI"
  description="Workshops, lectures, competitions, and seminars on AI education — online and in-person events hosted by InspireSaplingAI."
>
  <Navbar user={user} />
  <!-- Hero -->
  <section class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-emerald-900 pt-32 pb-20 px-4 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-indigo-200 text-sm font-semibold mb-6 border border-white/20">
        Free to Attend
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-5 leading-tight">
        Events & Programs
      </h1>
      <p class="text-xl text-indigo-100 max-w-2xl mx-auto leading-relaxed mb-8">
        Workshops, competitions, lectures, and panel discussions on AI in education — open to students, teachers, and curious minds everywhere.
      </p>

      <div class="flex items-center justify-center gap-8 flex-wrap">
        <div class="text-center">
          <p class="text-3xl font-extrabold">{upcomingEvents.length}</p>
          <p class="text-sm text-indigo-300">Upcoming Events</p>
        </div>
        <div class="w-px h-8 bg-white/20 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-3xl font-extrabold">{pastEvents.length}</p>
          <p class="text-sm text-indigo-300">Past Events</p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-16 space-y-20">

    <!-- Upcoming Events -->
    <section>
      <div class="flex items-center gap-3 mb-8">
        <span class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-primary-600"></span>
        </span>
        <h2 class="text-2xl font-extrabold text-gray-900">Upcoming Events</h2>
        <span class="px-2.5 py-0.5 rounded-full bg-primary-100 text-primary-700 text-xs font-bold">
          {upcomingEvents.length}
        </span>
      </div>

      {upcomingEvents.length === 0 ? (
        <div class="text-center py-16 bg-gray-50 rounded-2xl border border-gray-100">
          <p class="text-3xl mb-3">📅</p>
          <p class="text-gray-500 font-medium">No upcoming events at the moment.</p>
          <p class="text-gray-400 text-sm mt-1">Check back soon — we're always planning the next one!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {upcomingEvents.map(event => (
            <EventCard event={event.data} slug={event.id} />
          ))}
        </div>
      )}

      <!-- Registration note -->
      <div class="mt-8 p-4 bg-sky-50 border border-sky-200 rounded-xl flex items-start gap-3">
        <svg class="h-5 w-5 text-sky-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-sm text-sky-700">
          <strong>All events are free to attend.</strong> Sign in to register and receive a confirmation email. Your registered events appear in your <a href="/dashboard/events" class="underline font-medium">dashboard</a>.
        </p>
      </div>
    </section>

    <!-- Past Events -->
    {pastEvents.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-8">
          <h2 class="text-2xl font-extrabold text-gray-900">Past Events</h2>
          <span class="px-2.5 py-0.5 rounded-full bg-gray-100 text-gray-500 text-xs font-bold">
            {pastEvents.length}
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {pastEvents.map(event => (
            <EventCard event={event.data} slug={event.id} />
          ))}
        </div>
      </section>
    )}

    <!-- Stay Updated CTA -->
    <section class="bg-gradient-to-r from-indigo-600 to-emerald-600 rounded-3xl p-10 md:p-14 text-white text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-4">Stay in the Loop</h2>
      <p class="text-indigo-100 text-lg mb-8 max-w-xl mx-auto">
        New events are added regularly. Reach out to get notified about upcoming workshops and competitions.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/#contact"
          class="px-8 py-3.5 bg-white text-indigo-700 font-bold rounded-xl hover:bg-gray-50 transition-colors shadow-lg"
        >
          Contact Us
        </a>
        <a
          href="/resources"
          class="px-8 py-3.5 bg-white/10 border border-white/30 text-white font-bold rounded-xl hover:bg-white/20 transition-colors"
        >
          Explore Resources
        </a>
      </div>
    </section>
  </div>
</Layout>
