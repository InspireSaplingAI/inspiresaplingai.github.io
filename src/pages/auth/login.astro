---
import Layout from '../../layouts/Layout.astro'
import { createClient } from '../../lib/supabase'

export const prerender = false

const next = Astro.url.searchParams.get('next') || '/dashboard'
---

<Layout title="Log In — InspireSaplingAI">
    <div class="min-h-screen flex items-center justify-center px-4 py-24">
        <div class="w-full max-w-md">
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
                <h1 class="text-2xl font-bold text-gray-900 text-center mb-2">Welcome Back</h1>
                <p class="text-sm text-gray-500 text-center mb-8">Log in to your InspireSaplingAI account.</p>

                <form id="login-form" class="space-y-5">
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder="you@example.com"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
                        />
                    </div>
                    <div>
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            placeholder="Your password"
                            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow"
                        />
                    </div>
                    <button
                        type="submit"
                        class="w-full py-2.5 rounded-full bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
                    >
                        Log In
                    </button>
                </form>

                <p id="login-error" class="mt-4 text-sm text-red-600 text-center hidden"></p>

                <p class="mt-6 text-sm text-gray-500 text-center">
                    Don't have an account?
                    <a href="/auth/signup" class="text-primary-600 hover:text-primary-700 font-medium">Sign up</a>
                </p>

            </div>
        </div>
    </div>
</Layout>

<script>
    import { createClient } from '../../lib/supabase'

    const supabase = createClient()
    const form = document.getElementById('login-form')
    const errorEl = document.getElementById('login-error')

    // Get the redirect URL from the query param
    const params = new URLSearchParams(window.location.search)
    const next = params.get('next') || '/dashboard'

    form?.addEventListener('submit', async (e) => {
        e.preventDefault()
        errorEl?.classList.add('hidden')

        const formData = new FormData(e.target)
        const email = formData.get('email')
        const password = formData.get('password')

        const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
        })

        if (error) {
            errorEl.textContent = error.message
            errorEl.classList.remove('hidden')
        } else {
            window.location.href = next
        }
    })
</script>