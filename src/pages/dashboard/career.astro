---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import { createClient } from '../../lib/supabase-server'

export const prerender = false

const supabase = createClient(Astro)
const { data: { user } } = await supabase.auth.getUser()

// Fetch the user's credit usage for the counter
const { data: profile } = await supabase
    .from('profiles')
    .select('ai_credits_used')
    .eq('id', user?.id)
    .single()

const creditsUsed = profile?.ai_credits_used ?? 0
const FREE_LIMIT = 3
---

<Layout title="AI Career Assistant — InspireSaplingAI">
    <Navbar user={user} />
    <div class="min-h-screen bg-gray-50 pt-24 pb-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Header -->
            <div class="flex items-center gap-3 mb-8">
                <a href="/dashboard" class="text-gray-400 hover:text-gray-600 transition-colors" aria-label="Back to dashboard">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <h1 class="text-2xl font-bold text-gray-900">AI Career Assistant</h1>
            </div>

            <!-- Usage counter -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="font-semibold text-gray-900">Free Resume Analyses</h2>
                    <span class="px-3 py-1 text-sm font-bold rounded-full bg-primary-100 text-primary-700" id="credit-counter">
                        {creditsUsed} of {FREE_LIMIT} used
                    </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 overflow-hidden">
                    <div class="h-full bg-primary-600 rounded-full transition-all" id="credit-bar"
                         style={`width: ${Math.min((creditsUsed / FREE_LIMIT) * 100, 100)}%`}></div>
                </div>
                <p class="text-xs text-gray-400 mt-2">Upload your resume and get personalized feedback from AI.</p>
            </div>

            <!-- Resume Upload + Analysis form -->
            <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6" id="analyze-section">
                <h2 class="font-semibold text-gray-900 mb-4">Analyze My Resume</h2>

                <form id="analyze-form" class="space-y-4">
                    <!-- File input -->
                    <div>
                        <label for="resume-file" class="block text-sm font-medium text-gray-700 mb-1.5">Resume (PDF or DOCX, max 5MB)</label>
                        <input
                            id="resume-file"
                            name="file"
                            type="file"
                            accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                            required
                            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100 cursor-pointer"
                        />
                        <p class="text-xs text-gray-400 mt-1" id="file-error"></p>
                    </div>

                    <!-- Job title input -->
                    <div>
                        <label for="job-title" class="block text-sm font-medium text-gray-700 mb-1.5">Target Job Title</label>
                        <input
                            id="job-title"
                            name="job_title"
                            type="text"
                            placeholder="e.g., Machine Learning Engineer"
                            required
                            class="block w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                        />
                    </div>

                    <button
                        type="submit"
                        id="analyze-btn"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        Analyze My Resume
                    </button>
                </form>
            </section>

            <!-- Results -->
            <section class="space-y-6" id="results-section">
                <!-- Hidden empty state -->
            </section>

            <!-- Job Search -->
            <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <h2 class="font-semibold text-gray-900 mb-1">Search Real Jobs</h2>
                <p class="text-xs text-gray-400 mb-4">Find matching roles based on your target position.</p>

                <form id="jobs-form" class="space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label for="job-query" class="block text-sm font-medium text-gray-700 mb-1.5">Job Title</label>
                            <input
                                id="job-query"
                                type="text"
                                placeholder="e.g., Software Engineer"
                                required
                                class="block w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                            />
                        </div>
                        <div>
                            <label for="job-location" class="block text-sm font-medium text-gray-700 mb-1.5">Location</label>
                            <input
                                id="job-location"
                                type="text"
                                placeholder="e.g., Remote or New York, NY"
                                class="block w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
                            />
                        </div>
                    </div>
                    <button
                        type="submit"
                        id="jobs-btn"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gray-900 text-white text-sm font-semibold hover:bg-gray-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
                        </svg>
                        Search Jobs
                    </button>
                </form>

                <div id="jobs-results" class="mt-6 space-y-4"></div>
            </section>
        </div>
    </div>
</Layout>

<script>
    const FREE_LIMIT = 3
    const analyzeSection = document.getElementById('analyze-section')
    const uploadForm = document.getElementById('analyze-form')
    const analyzeBtn = document.getElementById('analyze-btn')
    const fileInput = document.getElementById('resume-file')
    const jobTitleInput = document.getElementById('job-title')
    const fileError = document.getElementById('file-error')
    const resultsSection = document.getElementById('results-section')
    const creditBar = document.getElementById('credit-bar')
    const creditCounter = document.getElementById('credit-counter')

    // --- Resume Analysis ---
    uploadForm?.addEventListener('submit', async (e) => {
        e.preventDefault()
        fileError!.textContent = ''

        const file = fileInput!.files?.[0]
        if (!file) {
            fileError!.textContent = 'Please select a resume file.'
            return
        }

        // Client-side size guard (server enforces too)
        if (file.size > 5 * 1024 * 1024) {
            fileError!.textContent = 'File must be 5MB or smaller.'
            return
        }

        // Client-side type guard
        if (!['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'].includes(file.type)) {
            fileError!.textContent = 'Only PDF or DOCX files are allowed.'
            return
        }

        analyzeBtn!.disabled = true
        analyzeBtn!.textContent = 'Analyzing… This may take up to 10 seconds.'

        try {
            // Step 1: Upload the file
            const fd = new FormData()
            fd.append('file', file)
            const uploadRes = await fetch('/api/ai/upload-resume', { method: 'POST', body: fd })

            if (uploadRes.status === 401) {
                window.location.href = '/auth/login?next=/dashboard/career'
                return
            }
            if (!uploadRes.ok) {
                const err = await uploadRes.json().catch(() => ({}))
                alert(err.message || 'Upload failed. Please try again.')
                return
            }
            const { storage_path } = await uploadRes.json()

            // Step 2: Analyze
            const jobTitle = (jobTitleInput as HTMLInputElement).value.trim()
            const analyzeRes = await fetch('/api/ai/analyze-resume', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ storage_path, job_title: jobTitle }),
            })

            if (analyzeRes.status === 429) {
                alert('You have reached the free limit of 3 analyses.')
                return
            }
            if (!analyzeRes.ok) {
                const err = await analyzeRes.json().catch(() => ({}))
                alert(`Analysis failed: ${err.message || 'Please try again.'}`)
                return
            }

            const data = await analyzeRes.json()
            renderAnalysis(data.analysis)
            updateCredits(data.credits_used)
            resultsSection!.scrollIntoView({ behavior: 'smooth' })
        } catch {
            alert('Network error. Please try again.')
        } finally {
            analyzeBtn!.disabled = false
            analyzeBtn!.textContent = 'Analyze My Resume'
        }
    })

    // Render the analysis results
    // @ts-ignore — analysis is JSON from the API
    function renderAnalysis(a) {
        if (!a) return
        const score = Number(a.overall_score ?? 0)
        const scoreColor = score >= 8 ? 'bg-emerald-100 text-emerald-700' : score >= 5 ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'
        let html = `
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="font-semibold text-gray-900">Analysis Results</h2>
                    <span class="px-3 py-1 rounded-full text-sm font-bold ${scoreColor}">${score}/10</span>
                </div>
                <p class="text-sm text-gray-600 mb-6">${a.summary || ''}</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <h3 class="text-sm font-semibold text-emerald-700 mb-2">✦ Strengths</h3>
                        <ul class="space-y-1.5">
                            ${(a.strengths || []).map((s) => `<li class="text-sm text-gray-700 flex gap-2"><span class="text-emerald-500">•</span>${s}</li>`).join('')}
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-sm font-semibold text-red-600 mb-2">⚠ Gaps</h3>
                        <ul class="space-y-1.5">
                            ${(a.gaps || []).map((s) => `<li class="text-sm text-gray-700 flex gap-2"><span class="text-red-400">•</span>${s}</li>`).join('')}
                        </ul>
                    </div>
                </div>

                <h3 class="text-sm font-semibold text-gray-900 mb-2">✏ Rewrite Suggestions</h3>
                <div class="space-y-4">
                    ${(a.rewrite_suggestions || []).map((r) => `
                        <div class="p-4 bg-gray-50 rounded-xl">
                            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">${r.section}</p>
                            <p class="text-sm text-gray-400 line-through decoration-gray-300 mb-1">${r.original}</p>
                            <p class="text-sm text-emerald-700">→ ${r.improved}</p>
                        </div>
                    `).join('')}
                </div>
            </div>
        `
        resultsSection!.innerHTML = html
    }

    function updateCredits(used: number) {
        creditCounter!.textContent = `${used} of ${FREE_LIMIT} used`
        creditBar!.style.width = `${Math.min((used / FREE_LIMIT) * 100, 100)}%`
    }

    // --- Job Search ---
    const jobsForm = document.getElementById('jobs-form')
    const jobsBtn = document.getElementById('jobs-btn')
    const jobsResults = document.getElementById('jobs-results')

    jobsForm?.addEventListener('submit', async (e) => {
        e.preventDefault()
        const query = (document.getElementById('job-query') as HTMLInputElement).value.trim()
        const location = (document.getElementById('job-location') as HTMLInputElement).value.trim()
        if (!query) return

        jobsBtn!.disabled = true
        jobsBtn!.textContent = 'Searching…'
        jobsResults!.innerHTML = '<p class="text-sm text-gray-400">Loading jobs…</p>'

        try {
            const params = new URLSearchParams({ query })
            if (location) params.set('location', location)
            const res = await fetch(`/api/jobs/search?${params.toString()}`)

            if (!res.ok) {
                const err = await res.json().catch(() => ({}))
                jobsResults!.innerHTML = `<p class="text-sm text-red-500">${err.message || 'Job search failed.'}</p>`
                return
            }

            const data = await res.json()
            if (data.jobs.length === 0) {
                jobsResults!.innerHTML = '<p class="text-sm text-gray-400">No jobs found. Try a different title or location.</p>'
                return
            }

            jobsResults!.innerHTML = data.jobs.map((job) => `
                <a href="${job.url}" target="_blank" rel="noopener noreferrer" class="block p-4 rounded-xl border border-gray-200 hover:border-primary-300 hover:bg-primary-50 transition-colors">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <p class="font-semibold text-gray-900 truncate">${job.title}</p>
                            <p class="text-sm text-gray-500">${job.company}</p>
                            <p class="text-xs text-gray-400 mt-1">${job.location}</p>
                        </div>
                        <div class="flex-shrink-0 text-right">
                            ${job.salary ? `<p class="text-sm font-medium text-primary-600">${job.salary}</p>` : ''}
                            <p class="text-xs text-gray-400">${job.source}</p>
                        </div>
                    </div>
                </a>
            `).join('')
        } catch {
            jobsResults!.innerHTML = '<p class="text-sm text-red-500">Network error. Please try again.</p>'
        } finally {
            jobsBtn!.disabled = false
            jobsBtn!.textContent = 'Search Jobs'
        }
    })
</script>