---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import { createClient } from '../../lib/supabase-server'

export const prerender = false

const supabase = createClient(Astro)
const {
    data: { user },
} = await supabase.auth.getUser()

// Fetch the user's coaching sessions
const { data: sessions } = await supabase
    .from('coaching_sessions')
    .select('*')
    .eq('member_id', user?.id)
    .order('booked_at', { ascending: false })

// Fetch mentor details for each session
const mentorIds = [...new Set((sessions ?? []).map((s) => s.mentor_id))]
let mentorsMap: Record<string, any> = {}

if (mentorIds.length > 0) {
    const { data: mentors } = await supabase
        .from('mentor_profiles')
        .select('id, name, avatar_url, title, company')
        .in('id', mentorIds)

    mentorsMap = Object.fromEntries((mentors ?? []).map((m) => [m.id, m]))
}

const enriched = (sessions ?? []).map((s) => ({
    ...s,
    mentor: mentorsMap[s.mentor_id] ?? null,
}))

const upcoming = enriched.filter((s) => s.status === 'pending' || s.status === 'paid')
const past = enriched.filter((s) => s.status === 'completed' || s.status === 'cancelled')

function formatDate(dateStr: string | null): string {
    if (!dateStr) return 'To be scheduled'
    return new Date(dateStr).toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'long',
        day: 'numeric',
        year: 'numeric',
    })
}

function formatAmount(cents: number | null): string {
    if (!cents) return '—'
    return `$${(cents / 100).toFixed(2)}`
}

function statusBadgeClass(status: string): string {
    switch (status) {
        case 'pending':
            return 'bg-amber-100 text-amber-700'
        case 'paid':
            return 'bg-emerald-100 text-emerald-700'
        case 'completed':
            return 'bg-gray-100 text-gray-500'
        case 'cancelled':
            return 'bg-red-50 text-red-500'
        default:
            return 'bg-gray-100 text-gray-500'
    }
}
---

<Layout title="My Coaching Sessions — InspireSaplingAI">
    <Navbar user={user} />
    <div class="min-h-screen bg-gray-50 pt-24 pb-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

            <!-- Header -->
            <div class="flex items-center gap-3 mb-8">
                <a
                    href="/dashboard"
                    class="text-gray-400 hover:text-gray-600 transition-colors"
                    aria-label="Back to dashboard"
                >
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <h1 class="text-2xl font-bold text-gray-900">My Coaching Sessions</h1>
            </div>

            <!-- Upcoming Sessions -->
            <section class="mb-10">
                <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                    Upcoming ({upcoming.length})
                </h2>

                {upcoming.length === 0 ? (
                    <div class="bg-white rounded-2xl border border-gray-100 p-10 text-center">
                        <p class="text-4xl mb-3">🎓</p>
                        <p class="text-gray-600 font-medium">No upcoming coaching sessions</p>
                        <a href="/mentors" class="mt-4 inline-block text-sm text-primary-600 hover:underline font-medium">
                            Browse mentors →
                        </a>
                    </div>
                ) : (
                    <ul class="space-y-4">
                        {upcoming.map((session) => (
                            <li class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex items-start justify-between gap-4">
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-3 mb-1">
                                        {session.mentor?.avatar_url ? (
                                            <img
                                                src={session.mentor.avatar_url}
                                                alt={session.mentor.name}
                                                class="w-9 h-9 rounded-full object-cover"
                                            />
                                        ) : (
                                            <div class="w-9 h-9 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 text-sm font-bold flex-shrink-0">
                                                {(session.mentor?.name || 'M').charAt(0).toUpperCase()}
                                            </div>
                                        )}
                                        <p class="font-semibold text-gray-900 truncate">
                                            {session.mentor?.name ?? 'Mentor'}
                                        </p>
                                    </div>
                                    <p class="text-sm text-gray-500 mt-1">{formatDate(session.session_date)}</p>
                                    <p class="text-xs text-gray-400">Booked {new Date(session.booked_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
                                    <div class="flex items-center gap-2 mt-2">
                                        <span class={`px-2.5 py-0.5 text-xs font-medium rounded-full ${statusBadgeClass(session.status)}`}>
                                            {session.status.charAt(0).toUpperCase() + session.status.slice(1)}
                                        </span>
                                        <span class="text-xs text-gray-400">{formatAmount(session.amount_cents)}</span>
                                    </div>
                                </div>
                            </li>
                        ))}
                    </ul>
                )}
            </section>

            <!-- Past & Cancelled -->
            {past.length > 0 && (
                <section>
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                        Past & Cancelled ({past.length})
                    </h2>
                    <ul class="space-y-3">
                        {past.map((session) => (
                            <li class="bg-white rounded-2xl border border-gray-100 p-5 flex items-center justify-between gap-4 opacity-60">
                                <div class="flex-1 min-w-0">
                                    <p class="font-medium text-gray-700 truncate">
                                        {session.mentor?.name ?? 'Mentor'}
                                    </p>
                                    <p class="text-xs text-gray-400 mt-0.5">{formatDate(session.session_date)}</p>
                                </div>
                                <span class={`text-xs font-medium px-2.5 py-0.5 rounded-full ${statusBadgeClass(session.status)}`}>
                                    {session.status.charAt(0).toUpperCase() + session.status.slice(1)}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            )}

            <!-- Book new session CTA -->
            <div class="mt-10">
                <a
                    href="/mentors"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 text-white text-sm font-semibold hover:bg-primary-700 transition-colors"
                >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Book a New Session
                </a>
            </div>
        </div>
    </div>
</Layout>