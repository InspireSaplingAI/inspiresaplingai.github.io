---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ResourceCard from '../../components/resources/ResourceCard.astro';

const user = Astro.locals.user;
const allResources = await getCollection('resources');
const resources = allResources.sort(
  (a, b) => b.data.published_at.localeCompare(a.data.published_at)
);

const totalCount = resources.length;
const beginnerCount = resources.filter(r => r.data.level === 'beginner').length;
const advancedCount = resources.filter(r => r.data.level === 'advanced').length;
---

<Layout
  title="Learning Resources | InspireSaplingAI"
  description="Free AI learning resources for students and educators — from beginner explainers to advanced research papers. Articles, videos, and curated links."
>
  <Navbar user={user} />
  <!-- Hero -->
  <section class="bg-gradient-to-br from-emerald-900 via-emerald-800 to-indigo-900 pt-32 pb-20 px-4 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 text-emerald-200 text-sm font-semibold mb-6 border border-white/20">
        Free & Open Access
      </span>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-5 leading-tight">
        Learning Resources
      </h1>
      <p class="text-xl text-emerald-100 max-w-2xl mx-auto leading-relaxed mb-8">
        Carefully curated materials to understand AI — whether you're exploring for the first time or diving deep into the research.
      </p>

      <!-- Stats row -->
      <div class="flex items-center justify-center gap-8 flex-wrap">
        <div class="text-center">
          <p class="text-3xl font-extrabold">{totalCount}</p>
          <p class="text-sm text-emerald-300">Total Resources</p>
        </div>
        <div class="w-px h-8 bg-white/20 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-3xl font-extrabold">{beginnerCount}</p>
          <p class="text-sm text-emerald-300">Beginner</p>
        </div>
        <div class="w-px h-8 bg-white/20 hidden sm:block"></div>
        <div class="text-center">
          <p class="text-3xl font-extrabold">{advancedCount}</p>
          <p class="text-sm text-emerald-300">Advanced</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter + Grid -->
  <section class="max-w-7xl mx-auto px-4 py-16">

    <!-- Filter bar -->
    <div class="flex flex-col sm:flex-row gap-4 mb-10">
      <!-- Level tabs -->
      <div class="flex rounded-xl bg-gray-100 p-1 gap-1" role="group" aria-label="Filter by level">
        <button
          data-level-filter="all"
          class="filter-btn-level px-4 py-2 rounded-lg text-sm font-semibold transition-colors bg-white text-gray-900 shadow-sm"
        >
          All Levels
        </button>
        <button
          data-level-filter="beginner"
          class="filter-btn-level px-4 py-2 rounded-lg text-sm font-semibold transition-colors text-gray-500 hover:text-gray-700"
        >
          🌱 Beginner
        </button>
        <button
          data-level-filter="advanced"
          class="filter-btn-level px-4 py-2 rounded-lg text-sm font-semibold transition-colors text-gray-500 hover:text-gray-700"
        >
          🔬 Advanced
        </button>
      </div>

      <!-- Type chips -->
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by type">
        <button
          data-type-filter="all"
          class="filter-btn-type px-3 py-1.5 rounded-full text-sm font-semibold border-2 border-gray-800 bg-gray-800 text-white transition-colors"
        >
          All Types
        </button>
        <button
          data-type-filter="article"
          class="filter-btn-type px-3 py-1.5 rounded-full text-sm font-semibold border-2 border-gray-200 text-gray-500 hover:border-gray-400 transition-colors"
        >
          📄 Articles
        </button>
        <button
          data-type-filter="link"
          class="filter-btn-type px-3 py-1.5 rounded-full text-sm font-semibold border-2 border-gray-200 text-gray-500 hover:border-gray-400 transition-colors"
        >
          🔗 Links
        </button>
        <button
          data-type-filter="video"
          class="filter-btn-type px-3 py-1.5 rounded-full text-sm font-semibold border-2 border-gray-200 text-gray-500 hover:border-gray-400 transition-colors"
        >
          🎥 Videos
        </button>
      </div>
    </div>

    <!-- Empty state (hidden by default, shown by JS) -->
    <div id="empty-state" class="hidden text-center py-20 text-gray-400">
      <p class="text-4xl mb-3">🔍</p>
      <p class="text-lg font-medium">No resources match your filters.</p>
      <button id="reset-filters" class="mt-4 text-sm text-primary-600 hover:underline">Reset filters</button>
    </div>

    <!-- Resource grid -->
    <div id="resource-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {resources.map(resource => (
        <ResourceCard resource={resource} />
      ))}
    </div>
  </section>
</Layout>

<script>
  const levelBtns = document.querySelectorAll<HTMLButtonElement>('[data-level-filter]');
  const typeBtns = document.querySelectorAll<HTMLButtonElement>('[data-type-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-level][data-type]');
  const emptyState = document.getElementById('empty-state');
  const grid = document.getElementById('resource-grid');
  const resetBtn = document.getElementById('reset-filters');

  let activeLevel = 'all';
  let activeType = 'all';

  function filterCards() {
    let visible = 0;
    cards.forEach(card => {
      const levelMatch = activeLevel === 'all' || card.dataset.level === activeLevel;
      const typeMatch = activeType === 'all' || card.dataset.type === activeType;
      const show = levelMatch && typeMatch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    if (grid) grid.classList.toggle('hidden', visible === 0);
  }

  levelBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      levelBtns.forEach(b => {
        b.classList.remove('bg-white', 'text-gray-900', 'shadow-sm');
        b.classList.add('text-gray-500');
      });
      btn.classList.add('bg-white', 'text-gray-900', 'shadow-sm');
      btn.classList.remove('text-gray-500');
      activeLevel = btn.dataset.levelFilter ?? 'all';
      filterCards();
    });
  });

  typeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      typeBtns.forEach(b => {
        b.classList.remove('border-gray-800', 'bg-gray-800', 'text-white');
        b.classList.add('border-gray-200', 'text-gray-500');
      });
      btn.classList.remove('border-gray-200', 'text-gray-500');
      btn.classList.add('border-gray-800', 'bg-gray-800', 'text-white');
      activeType = btn.dataset.typeFilter ?? 'all';
      filterCards();
    });
  });

  resetBtn?.addEventListener('click', () => {
    activeLevel = 'all';
    activeType = 'all';
    levelBtns.forEach((b, i) => {
      b.classList.toggle('bg-white', i === 0);
      b.classList.toggle('text-gray-900', i === 0);
      b.classList.toggle('shadow-sm', i === 0);
      b.classList.toggle('text-gray-500', i !== 0);
    });
    typeBtns.forEach((b, i) => {
      b.classList.toggle('border-gray-800', i === 0);
      b.classList.toggle('bg-gray-800', i === 0);
      b.classList.toggle('text-white', i === 0);
      b.classList.toggle('border-gray-200', i !== 0);
      b.classList.toggle('text-gray-500', i !== 0);
    });
    filterCards();
  });
</script>
