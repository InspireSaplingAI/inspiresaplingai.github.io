---
interface PillarItem {
  icon: string;
  title: string;
  description: string;
}
interface Props {
  headline: string;
  subtext: string;
  items: PillarItem[];
}
const { headline, subtext, items } = Astro.props;

const icons: Record<string, string> = {
  'chart-bar': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`,
  'user-group': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />`,
  beaker: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />`,
  star: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />`,
};

const colors = [
  { bg: 'bg-primary-50', border: 'border-primary-200', icon: 'bg-primary-100 text-primary-600', num: 'text-primary-500' },
  { bg: 'bg-secondary-50', border: 'border-secondary-200', icon: 'bg-secondary-100 text-secondary-600', num: 'text-secondary-500' },
  { bg: 'bg-emerald-50', border: 'border-emerald-200', icon: 'bg-emerald-100 text-emerald-600', num: 'text-emerald-500' },
  { bg: 'bg-indigo-50', border: 'border-indigo-200', icon: 'bg-indigo-100 text-indigo-600', num: 'text-indigo-500' },
];
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="inline-block mb-3 px-4 py-1 rounded-full bg-primary-100 text-primary-700 text-sm font-semibold uppercase tracking-wide">
        Strategic Pillars
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">{headline}</h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">{subtext}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {items.map((item, i) => {
        const c = colors[i % colors.length];
        return (
          <div class={`rounded-2xl p-8 border ${c.bg} ${c.border} transition-all hover:shadow-md`}>
            <div class="flex items-start gap-4">
              <div class={`flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center ${c.icon}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[item.icon] ?? icons['star']} />
              </div>
              <div>
                <p class={`text-xs font-black uppercase tracking-widest mb-1 ${c.num}`}>Pillar {i + 1}</p>
                <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
