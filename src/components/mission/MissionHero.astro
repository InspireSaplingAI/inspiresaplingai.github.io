---
interface Props {
  headline: string;
  subtext: string;
  heroImageAlt: string;
  videoId: string;
}
const { headline, subtext, heroImageAlt, videoId } = Astro.props;
---

<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-900 via-secondary-900 to-primary-900 pt-16 print:min-h-0 print:bg-white print:pt-4">
  <!-- Background placeholder (swap with real image via Unsplash URL in hero_image field) -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Decorative orbs -->
    <div class="absolute top-20 left-10 w-72 h-72 rounded-full bg-primary-500 opacity-10 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full bg-secondary-500 opacity-10 blur-3xl"></div>
    <!-- Grid overlay -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(rgba(255,255,255,.15) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.15) 1px, transparent 1px); background-size: 40px 40px;"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
    <span class="inline-block mb-5 px-4 py-1.5 rounded-full bg-white/10 text-white/80 text-sm font-semibold tracking-wide uppercase border border-white/20">
      Mission & Purpose
    </span>

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-6 print:text-gray-900 print:text-3xl">
      {headline}
    </h1>

    <p class="text-lg text-white/75 max-w-2xl mx-auto mb-10 leading-relaxed print:text-gray-600 print:text-base">
      {subtext}
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center print:hidden">
      <button
        id="download-pdf-btn"
        class="px-8 py-4 rounded-full bg-primary-500 text-white font-semibold text-base hover:bg-primary-400 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:ring-offset-2 focus:ring-offset-gray-900"
      >
        ↓ Download PDF
      </button>
      <button
        id="watch-video-btn"
        aria-label="Watch our intro video"
        class="flex items-center justify-center gap-2 px-8 py-4 rounded-full border-2 border-white/30 text-white font-semibold text-base hover:bg-white/10 transition-all focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-900"
        data-video-id={videoId}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Watch Our Story
      </button>
    </div>

    <!-- Image placeholder hint for future -->
    <p class="mt-6 text-xs text-white/30 print:hidden" aria-hidden="true">
      {heroImageAlt}
    </p>
  </div>
</section>

<!-- Video Modal -->
<div
  id="video-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Intro video"
  class="hidden fixed inset-0 z-[100] bg-black/80 flex items-center justify-center p-4 print:hidden"
>
  <div class="relative w-full max-w-3xl">
    <button
      id="close-video-btn"
      aria-label="Close video"
      class="absolute -top-10 right-0 text-white/70 hover:text-white text-3xl leading-none focus:outline-none"
    >
      ×
    </button>
    <div class="aspect-video rounded-2xl overflow-hidden bg-black">
      <iframe
        id="video-iframe"
        src=""
        title="InspireSaplingAI intro video"
        class="w-full h-full"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
    <p id="video-placeholder-msg" class="hidden text-center text-white/60 py-16 text-sm">
      Video coming soon — check back after we've published our intro on YouTube!
    </p>
  </div>
</div>

<script>
  const watchBtn = document.getElementById('watch-video-btn') as HTMLButtonElement | null;
  const modal = document.getElementById('video-modal');
  const closeBtn = document.getElementById('close-video-btn');
  const iframe = document.getElementById('video-iframe') as HTMLIFrameElement | null;
  const placeholder = document.getElementById('video-placeholder-msg');

  function openModal() {
    const videoId = watchBtn?.dataset.videoId ?? '';
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    if (videoId && videoId !== 'PLACEHOLDER_YOUTUBE_ID') {
      if (iframe) iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe?.classList.remove('hidden');
      placeholder?.classList.add('hidden');
    } else {
      iframe?.classList.add('hidden');
      placeholder?.classList.remove('hidden');
    }
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
    if (iframe) iframe.src = '';
  }

  watchBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
