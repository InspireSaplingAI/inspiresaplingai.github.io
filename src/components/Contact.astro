---
---

<section id="contact" class="py-24 bg-white">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-12">
      <span class="inline-block mb-3 px-4 py-1 rounded-full bg-primary-100 text-primary-700 text-sm font-semibold uppercase tracking-wide">
        Get in Touch
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
        Contact Us
      </h2>
      <p class="text-lg text-gray-500">
        Questions, partnership inquiries, or want to volunteer?
        We'd love to hear from you.
      </p>
    </div>

    <!-- Form -->
    <form
      action="https://formspree.io/f/mkoybqzy"
      method="POST"
      class="space-y-6"
    >
      <div class="grid sm:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
            Name <span class="text-red-500">*</span>
          </label>
          <input
            id="name"
            type="text"
            name="name"
            required
            autocomplete="name"
            placeholder="Your full name"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition text-sm"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
            Email <span class="text-red-500">*</span>
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition text-sm"
          />
        </div>
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">
          Subject
        </label>
        <input
          id="subject"
          type="text"
          name="subject"
          placeholder="e.g. Volunteer inquiry, Partnership, General question"
          class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition text-sm"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
          Message <span class="text-red-500">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="Tell us how you'd like to get involved or what you'd like to know..."
          class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 outline-none transition text-sm resize-none"
        ></textarea>
      </div>

      <!-- Honeypot (spam prevention) -->
      <input type="text" name="_gotcha" style="display:none" />

      <button
        type="submit"
        class="w-full py-4 rounded-xl bg-primary-600 text-white font-semibold text-base hover:bg-primary-700 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
      >
        Send Message
      </button>
    </form>
  </div>
</section>
