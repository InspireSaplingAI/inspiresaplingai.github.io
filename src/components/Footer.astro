---

<footer class="bg-gray-900 text-gray-400 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-3 gap-8 mb-10">
      <!-- Brand -->
      <div class="sm:col-span-1">
        <a href="/" class="flex items-center gap-2 text-white font-bold text-lg mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 32 32" fill="none">
            <circle cx="16" cy="16" r="16" fill="#059669"/>
            <path d="M16 6 C16 6 10 12 10 18 C10 21.3 12.7 24 16 24 C19.3 24 22 21.3 22 18 C22 12 16 6 16 6Z" fill="white"/>
            <line x1="16" y1="18" x2="16" y2="26" stroke="white" stroke-width="2" stroke-linecap="round"/>
          </svg>
          InspireSaplingAI
        </a>
        <p class="text-sm leading-relaxed">
          Empowering future minds in AI through open education and community.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wide mb-4">Navigate</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="#who-we-are" class="hover:text-primary-400 transition-colors">Who We Are</a></li>
          <li><a href="#problem-solution" class="hover:text-primary-400 transition-colors">Our Approach</a></li>
          <li><a href="#donate" class="hover:text-primary-400 transition-colors">Support Us</a></li>
          <li><a href="#contact" class="hover:text-primary-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Social / Connect -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wide mb-4">Connect</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/inspiresaplingai"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-primary-400 transition-colors flex items-center gap-2"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href="mailto:hello@inspiresaplingai.org"
              class="hover:text-primary-400 transition-colors flex items-center gap-2"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Email Us
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 text-center text-xs">
      <p>&copy; {new Date().getFullYear()} InspireSaplingAI. All rights reserved.</p>
    </div>
  </div>
</footer>
