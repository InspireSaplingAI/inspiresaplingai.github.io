---
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl text-primary-600 hover:text-primary-700 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="16" fill="#059669"/>
        <path d="M16 6 C16 6 10 12 10 18 C10 21.3 12.7 24 16 24 C19.3 24 22 21.3 22 18 C22 12 16 6 16 6Z" fill="white"/>
        <line x1="16" y1="18" x2="16" y2="26" stroke="white" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <span>InspireSaplingAI</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
      <li><a href="/mission" class="hover:text-primary-600 transition-colors">Mission</a></li>
      <li><a href="/resources" class="hover:text-primary-600 transition-colors">Resources</a></li>
      <li><a href="/events" class="hover:text-primary-600 transition-colors">Events</a></li>
      <li><a href="/membership" class="hover:text-primary-600 transition-colors">Membership</a></li>
      <li><a href="/donate" class="hover:text-primary-600 transition-colors">Donate</a></li>
      <li>
        <a
          href="/#contact"
          class="px-4 py-2 rounded-full bg-primary-600 text-white hover:bg-primary-700 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
        >
          Contact
        </a>
      </li>
    </ul>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      aria-label="Toggle menu"
      class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 px-4 py-4">
    <ul class="flex flex-col gap-4 text-sm font-medium text-gray-600">
      <li><a href="/" class="block hover:text-primary-600 transition-colors">Home</a></li>
      <li><a href="/mission" class="block hover:text-primary-600 transition-colors">Mission</a></li>
      <li><a href="/resources" class="block hover:text-primary-600 transition-colors">Resources</a></li>
      <li><a href="/events" class="block hover:text-primary-600 transition-colors">Events</a></li>
      <li><a href="/membership" class="block hover:text-primary-600 transition-colors">Membership</a></li>
      <li><a href="/donate" class="block hover:text-primary-600 transition-colors">Donate</a></li>
      <li><a href="/forum" class="block hover:text-primary-600 transition-colors">Forum</a></li>
      <li><a href="/volunteer" class="block hover:text-primary-600 transition-colors">Volunteer</a></li>
      <li><a href="/#contact" class="block hover:text-primary-600 transition-colors">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
  // Close mobile menu when a link is clicked
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => menu.classList.add('hidden'));
  });
</script>
