---
const problems = [
  'AI tools are rapidly entering classrooms, yet most teachers have no training to guide students through them.',
  'Existing AI education resources are fragmented, expensive, or inaccessible to under-resourced schools.',
  'Students from low-income and minority communities are disproportionately excluded from the AI economy.',
  'Without early exposure, the next generation risks becoming passive consumers of AI rather than informed participants.',
];

const solutions = [
  'We create free, standards-aligned AI curricula openly licensed for any school or educator to use.',
  'Our volunteer network delivers hands-on workshops directly in under-resourced communities.',
  'We offer mentorship programs pairing students with AI professionals from diverse backgrounds.',
  'We advocate for equitable AI literacy policies at the district and state level.',
];
---

<section id="problem-solution" class="py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block mb-3 px-4 py-1 rounded-full bg-secondary-100 text-secondary-700 text-sm font-semibold uppercase tracking-wide">
        Our Approach
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">
        The Problem & Our Solution
      </h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        AI is reshaping every corner of society — but access to AI education remains deeply unequal.
      </p>
    </div>

    <!-- Two-column cards -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Problem card -->
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-red-100">
        <div class="flex items-center gap-3 mb-6">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-gray-900">The Challenge</h3>
        </div>
        <ul class="space-y-4">
          {problems.map(p => (
            <li class="flex gap-3 text-gray-600 text-sm leading-relaxed">
              <span class="flex-shrink-0 mt-1 w-2 h-2 rounded-full bg-red-400"></span>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <!-- Solution card -->
      <div class="bg-white rounded-3xl p-8 shadow-sm border border-primary-100">
        <div class="flex items-center gap-3 mb-6">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </span>
          <h3 class="text-xl font-bold text-gray-900">Our Solution</h3>
        </div>
        <ul class="space-y-4">
          {solutions.map(s => (
            <li class="flex gap-3 text-gray-600 text-sm leading-relaxed">
              <span class="flex-shrink-0 mt-1 w-2 h-2 rounded-full bg-primary-500"></span>
              {s}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
